// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  password       String
  email          String   @unique
  profileImageURL String?
  createdAt      DateTime @default(now())
  accessToken    String?
  refreshToken   String?
  
  // Relations
  participations Participant[]
  bracketScoreWins BracketScore[] @relation("BracketScoreWinner")
}

model Tournament {
  id           Int      @id @default(autoincrement())
  name         String
  date         DateTime
  game         String
  status       String
  admins       String[] // User usernames
  participants String[] // User usernames
  
  // Relations
  participantRecords Participant[]
  bracketScores BracketScore[]
}

model Participant {
  tournamentId Int
  userId       Int
  alias        String
  prefix       String

  // Relations
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@id([tournamentId, userId])
}

model BracketScore {
  tournamentId Int
  roundId      Int
  userIds      Int[]
  scores       Int[]
  winnerId     Int

  // Relations
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  winner       User?      @relation("BracketScoreWinner", fields: [winnerId], references: [id])

  @@id([tournamentId, roundId])
}
